# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://trader:secure_trading_password@localhost:5432/crypto_bot
# For Docker Compose: postgresql://trader:secure_trading_password@postgres:5432/crypto_bot

# ==========================================
# BOT CONFIGURATION
# ==========================================

# Trading Mode: LIVE, PAPER, atau BACKTEST
# LIVE = Trading dengan uang asli (BAHAYA!)
# PAPER = Trading dengan uang virtual/monopoli (AMAN untuk testing)
# BACKTEST = Testing strategi dengan data historis
BOT_MODE=PAPER

# ==========================================
# TOKOCRYPTO API (Untuk Live & Paper Trading)
# ==========================================
TOKO_API_KEY=your_tokocrypto_api_key_here
TOKO_SECRET_KEY=your_tokocrypto_secret_key_here

# ==========================================
# SOLANA CONFIGURATION
# ==========================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your_solana_private_key_here
JUPITER_API_KEY=your_jupiter_api_key_here

# Solana Mode: TRUE = Simulation, FALSE = Real Money
IS_SIMULATION=TRUE

# ==========================================
# PAPER TRADING CONFIGURATION
# ==========================================
PAPER_INITIAL_BALANCE=1000.0

# ==========================================
# RISK MANAGEMENT
# ==========================================
MAX_POSITION_SIZE_PCT=20.0      # Max % capital per position
MAX_PORTFOLIO_DRAWDOWN_PCT=15.0 # Max portfolio drawdown
MAX_DAILY_LOSS_PCT=5.0          # Max loss per day
MAX_OPEN_POSITIONS=5            # Max concurrent positions
RISK_PER_TRADE_PCT=2.0          # Risk per trade

# ==========================================
# TRADING FEES & SLIPPAGE
# ==========================================
TRADING_FEE_PCT=0.1             # Exchange fee (0.1% = 0.001)
SLIPPAGE_PCT=0.05               # Slippage estimation (0.05% = 0.0005)
